# AER — Autonomous HR Escalation Referee
# Copy to .env and adjust as needed for local development.

# HTTP port for the Express server (default: 4647)
PORT=4647

# Browser origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=https://clearflowhr.quangtrioj.edu.vn

# Environment: development | production
NODE_ENV=development

# ShopAIKey API key — used ONLY for:
#   1. VLM OCR: structural analysis of C65-HD forms (stamp/signature detection)
#   2. Escalation language synthesis: rewriting HITL questions in natural language
# NEVER used for leave balance calculations, policy decisions, or date imputation.
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_BASE_URL=https://api.shopaikey.com
AI_MODEL=claude-opus-5-5

# AI models (ShopAIKey Anthropic Messages API)
VLM_MODEL=claude-sonnet-5-5
SYNTH_MODEL=claude-opus-5-5
SYNTH_LLM_ENABLED=false

# Optional comma-separated model fallbacks. The client tries these in order
# when the primary model is rate-limited or unavailable. Every VLM fallback
# must support image input.
VLM_FALLBACK_MODELS=
SYNTH_FALLBACK_MODELS=

# Local cooldown after a provider 429 (milliseconds; maximum 300000).
# This avoids repeatedly calling a provider pool that has already rate-limited.
OPENROUTER_RATE_LIMIT_COOLDOWN_MS=30000

# VLM and synthesis request timeouts in milliseconds (VLM capped at 30000;
# synthesis capped at 10000 and only used when SYNTH_LLM_ENABLED=true or in development).
VLM_TIMEOUT_MS=30000
SYNTH_TIMEOUT_MS=8000
